-- =====================================================================
-- CAIMANDB NQL
-- DATABASE: ZOO MANAGEMENT SYSTEM
-- A complete, professional reference script exercising every command
-- category supported by the CaimanDB query engine.
--
-- Runs top to bottom with:   caimandb run zoo.nql
-- (or pasted statement by statement into the web console).
--
-- Every statement below matches the grammar the engine actually
-- implements. Notes on the forms that are easy to get wrong are inline,
-- marked with "NOTE:".
-- =====================================================================


-- =====================================================================
-- 1. DATABASE COMMANDS
-- =====================================================================

CREATE DB zoo
USE zoo

SHOW DBS
SHOW DBS zoo
INFO DB zoo


-- =====================================================================
-- 2. BLOCK COMMANDS
-- =====================================================================

-- Several blocks created in a single statement (current db, via USE).
-- The statement stays open until the parenthesis closes, so it can span
-- as many lines as you like.
CREATE BLOCK (
    species,
    habitats,
    zones,
    animals,
    caretakers,
    veterinarians,
    treatments,
    foods,
    feedings,
    visitors,
    visits,
    employees,
    events,
    donations,
    suppliers,
    purchases
)

SHOW BLOCKS
SHOW BLOCKS zoo animals species


-- =====================================================================
-- 3. NAMED INDEXES
-- =====================================================================

CREATE UNIQUE INDEX idx_species_scientific ON species (scientific_name)
CREATE INDEX idx_animal_species ON animals (species_id)
CREATE INDEX idx_animal_habitat ON animals (habitat_id)
CREATE INDEX idx_animal_status ON animals (status)
CREATE INDEX idx_animal_name ON animals (name)
CREATE INDEX idx_animal_weight ON animals (weight_kg)
CREATE INDEX idx_animal_age ON animals (age)
CREATE INDEX idx_treatment_animal ON treatments (animal_id)
CREATE INDEX idx_visit_visitor ON visits (visitor_id)
CREATE INDEX idx_active_animals ON animals (status) WHERE status = "healthy"

SHOW INDEXES ON animals
SHOW INDEXES ON species


-- =====================================================================
-- 4. INSERT — every variant
-- =====================================================================

-- 4.1 Plain JSON document, id generated by the engine.
-- NOTE: nothing else in this script references this species, precisely
-- because its id isn't known in advance.
INSERT species {
    "name": "Snow Leopard",
    "scientific_name": "Panthera uncia",
    "family": "Felidae",
    "class": "Mammal",
    "order": "Carnivora",
    "conservation_status": "Vulnerable",
    "continent": "Asia",
    "diet": "Carnivore",
    "life_expectancy": 18
}

-- 4.2 JSON document with an explicit id (id goes right after the block)
INSERT species sp_lion {
    "name": "African Lion",
    "scientific_name": "Panthera leo",
    "family": "Felidae",
    "class": "Mammal",
    "order": "Carnivora",
    "conservation_status": "Vulnerable",
    "continent": "Africa",
    "diet": "Carnivore",
    "life_expectancy": 14
}

INSERT species sp_tiger {
    "name": "Bengal Tiger",
    "scientific_name": "Panthera tigris tigris",
    "family": "Felidae",
    "class": "Mammal",
    "order": "Carnivora",
    "conservation_status": "Endangered",
    "continent": "Asia",
    "diet": "Carnivore",
    "life_expectancy": 16
}

-- 4.3 Batch insert via a JSON array — the only multi-document form that
-- supports a per-document id, given as "_id" inside each object.
-- NOTE: the ";"-separated form (see 4.10) inserts several documents too,
-- but an explicit id there applies only to the first one, so ids for the
-- rest have to travel inside the documents like this.
INSERT species [
    {"_id": "sp_elephant", "name": "African Elephant", "scientific_name": "Loxodonta africana", "family": "Elephantidae", "class": "Mammal", "order": "Proboscidea", "conservation_status": "Endangered", "continent": "Africa", "diet": "Herbivore", "life_expectancy": 60},
    {"_id": "sp_giraffe", "name": "Giraffe", "scientific_name": "Giraffa camelopardalis", "family": "Giraffidae", "class": "Mammal", "order": "Artiodactyla", "conservation_status": "Vulnerable", "continent": "Africa", "diet": "Herbivore", "life_expectancy": 25},
    {"_id": "sp_bear", "name": "Brown Bear", "scientific_name": "Ursus arctos", "family": "Ursidae", "class": "Mammal", "order": "Carnivora", "conservation_status": "Least concern", "continent": "Europe", "diet": "Omnivore", "life_expectancy": 30},
    {"_id": "sp_crocodile", "name": "Nile Crocodile", "scientific_name": "Crocodylus niloticus", "family": "Crocodylidae", "class": "Reptile", "order": "Crocodylia", "conservation_status": "Least concern", "continent": "Africa", "diet": "Carnivore", "life_expectancy": 50},
    {"_id": "sp_flamingo", "name": "Greater Flamingo", "scientific_name": "Phoenicopterus roseus", "family": "Phoenicopteridae", "class": "Bird", "order": "Phoenicopteriformes", "conservation_status": "Least concern", "continent": "Europe", "diet": "Omnivore", "life_expectancy": 25},
    {"_id": "sp_penguin", "name": "Emperor Penguin", "scientific_name": "Aptenodytes forsteri", "family": "Spheniscidae", "class": "Bird", "order": "Sphenisciformes", "conservation_status": "Near threatened", "continent": "Antarctica", "diet": "Carnivore", "life_expectancy": 20}
]

-- 4.4 Zones — key:value format
INSERT zones zone_savanna name: "African Savanna", continent: "Africa", status: "active"
INSERT zones zone_asia name: "Asian Rainforest", continent: "Asia", status: "active"
INSERT zones zone_polar name: "Polar Region", continent: "Antarctica", status: "active"
INSERT zones zone_europe name: "European Woodlands", continent: "Europe", status: "maintenance"

-- 4.5 Habitats — key=value format
INSERT habitats hab_lion name = "Lion Savanna Enclosure", type = "Savanna", zone_id = "zone_savanna", capacity = 10, current_animals = 0, temperature = 28, has_water = true
INSERT habitats hab_tiger name = "Tiger Jungle Enclosure", type = "Jungle", zone_id = "zone_asia", capacity = 6, current_animals = 0, temperature = 26, has_water = true
INSERT habitats hab_polar name = "Antarctic Ice Field", type = "Polar", zone_id = "zone_polar", capacity = 20, current_animals = 0, temperature = -3, has_water = true
INSERT habitats hab_forest name = "European Forest Enclosure", type = "Forest", zone_id = "zone_europe", capacity = 8, current_animals = 0, temperature = 18, has_water = true


-- Several documents in one statement, ";"-separated (ids auto-generated)
INSERT donations {"donor": "Save the Animals", "amount": 75000, "currency": "USD", "date": "2026-09-05", "purpose": "conservation"}; {"donor": "Green Earth Foundation", "amount": 45000, "currency": "EUR", "date": "2026-09-12", "purpose": "habitats"}

INSERT purchases com001 {"supplier_id": "prov001", "food_id": "food_meat", "quantity": 500, "total_price": 15000, "date": "2026-09-05"}
INSERT purchases com002 {"supplier_id": "prov002", "food_id": "food_fruit", "quantity": 400, "total_price": 8000, "date": "2026-09-08"}


-- =====================================================================
-- 5. RELATE — declarative relationships (resolved automatically by FIND)
-- =====================================================================
-- NOTE: RELATE confirms the foreign-key field name against documents
-- already stored, so it goes AFTER the inserts, not before them.

RELATE animals USE species, habitats
RELATE habitats USE zones
RELATE treatments USE animals, veterinarians
RELATE feedings USE animals, foods
RELATE visits USE visitors
RELATE events USE zones
RELATE purchases USE suppliers, foods
-- Cross-database example:
-- RELATE animals USE archive.species, archive.habitats


-- =====================================================================
-- 6. FIND / GET — queries
-- =====================================================================

FIND animals
GET animals lion001
GET animals @ lion001

FIND animals WHERE age > 5 ORDER age:DESC
FIND animals WHERE weight_kg BETWEEN 100 AND 1000
FIND animals WHERE status = "healthy" AND age >= 5
FIND animals WHERE status = "healthy" OR status = "observation"
FIND animals WHERE NOT (status = "sick" OR status = "quarantine")
FIND animals WHERE (status = "healthy" OR status = "observation") AND weight_kg >= 50

FIND animals SELECT name, species.name, habitats.name
FIND animals WHERE species_id = "sp_lion" SELECT name, weight_kg, age, habitat_id
FIND animals WHERE species.continent = "Africa" SELECT name, species.name, habitats.name

-- Filtering through a RELATE alias
FIND animals SELECT name, species.name WHERE species.diet = "Carnivore"

-- Computed SELECT fields
FIND animals SELECT name, COUNT(tags) AS tag_count, age
FIND animals SELECT name, weight_kg / 1000 AS weight_tons

-- GROUP BY / HAVING inside FIND
FIND animals SELECT species_id, COUNT(tags) AS tag_count WHERE status = "healthy" GROUP BY species_id HAVING COUNT(tags) >= 2

-- DISTINCT
FIND animals DISTINCT
FIND animals DISTINCT species_id
FIND animals DISTINCT species_id, status
FIND animals SELECT status DISTINCT status WHERE weight_kg > 10

-- Sorting, pagination, table output
FIND animals ORDER name, weight_kg:DESC WHERE weight_kg > 10
FIND animals WHERE weight_kg > 10 LIMIT 20 OFFSET 0
FIND animals WHERE status = "healthy" --type:table

-- EXPLAIN — runs the query for real and reports what happened
EXPLAIN FIND animals WHERE weight_kg > 100 ORDER weight_kg:DESC LIMIT 10
EXPLAIN SEARCH animals "lion"


-- =====================================================================
-- 7. SEARCH — full-text
-- =====================================================================

SEARCH animals "lion"
SEARCH animals "African elephant" EXACT
SEARCH animals "~elefant" FUZZY
SEARCH animals "lion" WITH SCORE WITH MATCHES
SEARCH animals "+carnivore -sick optional_term"
SEARCH animals "tiger" WHERE status = "healthy" LIMIT 20 ORDER name


-- =====================================================================
-- 8. UPDATE
-- =====================================================================

UPDATE animals WHERE _id = "lion001" SET name = "Simba the Great", weight_kg = 195
UPDATE animals WHERE _id = "lion001" INC age = 1
UPDATE animals WHERE _id = "ele001" DEC weight_kg = 5
UPDATE animals WHERE _id = "lion001" PUSH tags = "on_display"
UPDATE animals WHERE _id = "lion001" PULL tags = "quarantine"
UPDATE animals WHERE status = "healthy" PUSH tags = "daily_checked"
UPDATE ALL animals SET last_reviewed = now()
UPDATE animals WHERE status = "draft" SET status = "healthy", reviewed_at = now()


-- =====================================================================
-- 9. DELETE
-- =====================================================================

DELETE animals WHERE _id = "unused_placeholder"
DELETE animals WHERE weight_kg < 0.001


-- =====================================================================
-- 10. ADD FIELD / DROP FIELD / TRUNCATE / UPSERT
-- =====================================================================
-- NOTE: only the FIRST field carries the "<block>." prefix. Every field
-- after a comma belongs to the same block and must be written bare --
-- writing "animals.insurance_covered" in second position creates (or
-- looks for) a field literally named "animals.insurance_covered".

ADD FIELD animals.microchip_id DEFAULT null
ADD FIELD animals.last_checkup DEFAULT null, insurance_covered DEFAULT false

DROP FIELD animals.insurance_covered
DROP FIELD animals.microchip_id, last_checkup WHERE status = "healthy"

UPSERT animals lion001 SET status = "healthy", weight_kg = 198
UPSERT animals newborn001 {"name": "Kiara", "species_id": "sp_lion", "sex": "F", "age": 0, "weight_kg": 2.1, "status": "observation", "habitat_id": "hab_lion", "admission_date": "2026-09-09", "tags": ["newborn"]}

-- TRUNCATE empties a block instantly with no confirmation prompt
-- TRUNCATE purchases


-- =====================================================================
-- 11. AGGREGATIONS
-- =====================================================================

COUNT animals
COUNT animals WHERE status = "healthy"
SUM purchases total_price WHERE date = "2026-09-05"
AVG animals weight_kg WHERE species_id = "sp_lion"
MIN animals age
MAX animals age
MEDIAN animals weight_kg
MODE animals status
STDDEV animals weight_kg


-- =====================================================================
-- 12. GROUP BY
-- =====================================================================

GROUP animals BY species_id COUNT
GROUP animals BY status COUNT
GROUP animals BY habitat_id COUNT
GROUP purchases BY supplier_id SUM total_price
GROUP animals BY species_id AVG weight_kg WHERE status = "healthy"
GROUP visitors BY type COUNT
GROUP employees BY department COUNT
GROUP donations BY purpose SUM amount


-- =====================================================================
-- 13. ACID TRANSACTIONS
-- =====================================================================
-- NOTE: a transaction is bound to ONE <db> <block> pair, the one named
-- in BEGIN. Every INSERT/UPDATE/DELETE between BEGIN and COMMIT must
-- target that block; touching a second block means a second transaction.
-- Nothing is visible to FIND until COMMIT, and ROLLBACK discards it all.

BEGIN zoo animals
    INSERT animals tig002 {
        "name": "Akira",
        "species_id": "sp_tiger",
        "sex": "F",
        "age": 3,
        "weight_kg": 145,
        "status": "quarantine",
        "habitat_id": "hab_tiger",
        "admission_date": "2026-09-09",
        "tags": ["new", "quarantine"]
    }
COMMIT

BEGIN zoo habitats
    UPDATE habitats WHERE _id = "hab_tiger" INC current_animals = 1
COMMIT

-- Example of an aborted transaction (no changes are kept)
BEGIN zoo animals
    INSERT animals bad001 {"name": "Placeholder entry"}
ROLLBACK

-- Proof that the rollback really discarded it: this must find nothing.
GET animals bad001

TX STATUS
TX LIST
TX ISOLATION


-- =====================================================================
-- 14. TURBO / BULK LOADING
-- =====================================================================

BULK MODE ON
BULK STATUS
BULK MODE OFF

-- Streaming import from a file, for large loads. Uncomment once the
-- path exists on the server's filesystem:
-- IMPORT animals FROM FILE '/data/animals_bulk.ndjson' FORMAT NDJSON BATCH 50000
-- IMPORT animals FROM FILE '/data/animals_bulk.json.gz' FORMAT ARRAY


-- =====================================================================
-- 15. JOIN
-- =====================================================================

JOIN animals WITH feedings ON animals._id = feedings.animal_id
JOIN feedings WITH foods ON feedings.food_id = foods._id
JOIN treatments WITH animals ON treatments.animal_id = animals._id
JOIN treatments WITH veterinarians ON treatments.veterinarian_id = veterinarians._id
JOIN events WITH zones ON events.zone_id = zones._id
JOIN purchases WITH suppliers ON purchases.supplier_id = suppliers._id


-- =====================================================================
-- 16. AUTORELATIONS — automatic read-pattern graph (no RELATE needed)
-- =====================================================================

SHOW AUTORELATIONS animals
SHOW AUTORELATIONS animals FROM lion001
SHOW AUTORELATIONS animals FROM lion001 DEPTH 3 DIRECTION BOTH FORMAT TREE
SHOW AUTORELATIONS animals STATS
SHOW AUTORELATIONS animals WHERE access_count > 10 ORDER BY DEGREE LIMIT 20
SHOW AUTORELATIONS animals CYCLES
SHOW AUTORELATIONS animals BROKEN


-- =====================================================================
-- 17. VIEWS
-- =====================================================================

VIEW CREATE healthy_animals AS FIND animals WHERE status = "healthy"
VIEW CREATE observation_animals AS FIND animals WHERE status = "observation"
VIEW CREATE animals_overview AS FIND animals SELECT name, species.name, habitats.name

VIEW SHOW
VIEW INFO healthy_animals

-- Querying a view: its bare name is a command on its own
healthy_animals

VIEW DROP observation_animals


-- =====================================================================
-- 18. EXPORT / IMPORT
-- =====================================================================
-- EXPORT writes <name>.csv AND <name>.json into the backups directory,
-- so the base name goes without extension. IMPORT looks there too when
-- the path has no directory part.

EXPORT animals TO "animals_export"
EXPORT animals WHERE status = "healthy" TO "healthy_animals_export"

IMPORT animals FROM "animals_export.json"
IMPORT animals FROM "animals_export.csv"


-- =====================================================================
-- 19. RENAME FIELD
-- =====================================================================

RENAME FIELD animals.weight_kg TO body_weight_kg
RENAME FIELD zoo animals.body_weight_kg TO weight_kg


-- =====================================================================
-- 20. FLEX-COLUMN
-- =====================================================================

FLEX STATS
FLEX HOT animals
FLEX REINDEX animals
FLEX REINDEX zoo animals


-- =====================================================================
-- 21. USER MANAGEMENT
-- =====================================================================
-- NOTE: every role except ADMIN_GENERAL belongs to exactly one database,
-- so DATABASE <db> is mandatory. A statement can also be written across
-- several lines by ending each one (but the last) with a backslash.

CREATE USER analyst IDENTIFIED BY "S3cretPass!" ROLE USER DATABASE zoo

CREATE USER carla IDENTIFIED BY "AnotherPass!" ROLE DEVELOPER STATUS ACTIVE \
    DATABASE zoo \
    DEFAULT DATABASE zoo DEFAULT BLOCK animals \
    PASSWORD EXPIRE DAYS 90 ACCOUNT LOCK OFF \
    COMMENT "Zoo operations integration account"

SHOW USERS

CREATE SERVER main_branch ADMIN IDENTIFIED BY "AdminPass!"
CREATE SERVER north_branch ADMIN north_admin IDENTIFIED BY "AdminPass2!"

DROP USER analyst


-- =====================================================================
-- 22. ACCESS CONTROL
-- =====================================================================
-- NOTE: the action list is a single token — "read,write", no space,
-- since ON must be the token right after it.

GRANT read ON zoo.animals TO carla
GRANT read,write ON zoo.* TO carla
GRANT read ON zoo TO carla
REVOKE write ON zoo.animals FROM carla

SHOW GRANTS
SHOW GRANTS FOR carla


-- =====================================================================
-- 23. SHARD MANAGEMENT
-- =====================================================================

SHARD STATUS
SHARD REBALANCE
SHARD SCALE zoo 8


-- =====================================================================
-- 24. CLUSTER
-- =====================================================================

CLUSTER STATUS


-- =====================================================================
-- 25. BACKUP / RESTORE / VERIFY
-- =====================================================================

BACKUP zoo TO "zoo_2026-09-09.bak"
VERIFY BACKUP zoo
-- RESTORE zoo FROM "zoo_2026-09-09.bak"

-- Encrypted, incremental backup (no destination file: the path is
-- chosen automatically under backups/arw/)
-- BACKUP zoo FULL


-- =====================================================================
-- 26. CHECKPOINT
-- =====================================================================

CHECKPOINT


-- =====================================================================
-- 27. NAVIGATION & SYSTEM
-- =====================================================================

PWD
LS
LS zoo
CD zoo
TREE
STATUS
HEALTH
VERSION
PING
HELP


-- =====================================================================
-- 28. DIAGNOSTICS & MAINTENANCE
-- =====================================================================

DESCRIBE DB zoo
DESCRIBE BLOCK animals
DESCRIBE BLOCK species
DESCRIBE BLOCK habitats

STATS DB zoo
SIZE DB zoo
SIZE BLOCK animals

ANALYZE DB zoo
ANALYZE BLOCK animals

OPTIMIZE DB zoo
OPTIMIZE BLOCK animals

REBUILD BLOCK animals
CHECK BLOCK animals
REPAIR BLOCK animals

COMPACT zoo


-- =====================================================================
-- 29. ADVANCED QUERIES — practical operational examples
-- =====================================================================

-- Active treatments joined with their patients
FIND treatments WHERE status = "active"
JOIN animals WITH treatments ON animals._id = treatments.animal_id

-- Today's feeding schedule
FIND feedings WHERE date = "2026-09-09"
JOIN animals WITH feedings ON animals._id = feedings.animal_id

-- Zones and their habitats
JOIN zones WITH habitats ON zones._id = habitats.zone_id
JOIN habitats WITH animals ON habitats._id = animals.habitat_id

-- Species with the most individuals
GROUP animals BY species_id COUNT

-- Most consumed foods
GROUP feedings BY food_id SUM quantity

-- Visitors by type
GROUP visitors BY type COUNT

-- Employees by department
GROUP employees BY department COUNT

-- Donations by purpose
GROUP donations BY purpose SUM amount

-- Events by zone
GROUP events BY zone_id COUNT



INSERT suppliers prov002 name: "Fresh Animal Nutrition", category: "feeding", phone: "4625551002", active: true

-- 4.9 Treatments — the veterinary log JOINed in section 29
INSERT treatments tre001 {"animal_id": "ele001", "veterinarian_id": "vet001", "diagnosis": "Left front foot inflammation", "treatment": "Anti-inflammatory + rest", "status": "active", "start_date": "2026-09-07"}

-- 4.7 Import documents from an external file (blocking, whole-file read)
-- NOTE: the path is resolved relative to the process, falling back to the
-- backups directory. Section 18 below exercises this against files this
-- very script produces, so nothing here depends on a file that may not
-- exist yet:
--     INSERT animals FROM "animals_seed.json"
--     INSERT animals FROM "animals_seed.csv"

-- 4.8 Caretakers, veterinarians, foods, employees, suppliers — mixed styles
INSERT caretakers cui001 name: "Laura Jimenez", specialty: "Big cats", zone_id: "zone_savanna", shift: "morning"
INSERT caretakers cui002 name: "Marco Diaz", specialty: "Primates and birds", zone_id: "zone_asia", shift: "afternoon"
INSERT caretakers cui003 name: "Elena Ruiz", specialty: "Polar species", zone_id: "zone_polar", shift: "morning"

INSERT veterinarians vet001 {"name": "Dr. Ana Morales", "specialty": "Big mammals", "phone": "4625550101", "active": true}
INSERT veterinarians vet002 {"name": "Dr. Hugo Mendez", "specialty": "Exotic birds", "phone": "4625550102", "active": true}
INSERT veterinarians vet003 {"name": "Dr. Paula Rios", "specialty": "Reptiles", "phone": "4625550103", "active": true}

